+.inner { max-width: 1120px; margin-inline: auto; padding: 56px 20px; }
+.center { text-align: center; }
+
+.eyebrow, .eyebrowDark { margin: 0 0 12px; font-size: var(--step--1); font-weight: 800; letter-spacing: .08em; color: var(--accent-text); }
+.eyebrowDark { color: var(--accent-on-dark); }
+.h1 { margin: 0 0 14px; font-size: clamp(2.2rem, 7vw, 3.6rem); font-weight: 800; line-height: 1.04; letter-spacing: -.03em; color: var(--nav-text); text-wrap: balance; }
+.h2, .h2Dark { margin: 0 0 14px; font-size: clamp(1.7rem, 5vw, 2.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -.02em; color: var(--text); text-wrap: balance; }
+.h2Dark { color: var(--nav-text); }
+.lede { margin: 0; max-width: 52ch; color: var(--nav-muted); font-size: var(--step-1); line-height: 1.7; }
+.text, .textDark { margin: 0 0 22px; color: var(--text2); font-size: var(--step-1); line-height: 1.7; max-width: 52ch; }
+.textDark { color: var(--nav-muted); }
+
+.top { background: var(--nav-bg); }
+.top .inner { padding-top: 64px; padding-bottom: 64px; text-align: center; display: grid; justify-items: center; }
+.pick { background: var(--bg); }
+.pick .inner { padding-top: 0; transform: translateY(-36px); padding-bottom: 20px; }
+
+.btnPrimary, .btnLight {
+  display: inline-flex; align-items: center; justify-content: center;
+  min-height: 54px; padding: 0 28px;
+  font-size: var(--step-1); font-weight: 800; text-decoration: none;
+  border: 2px solid transparent;
+}
+.btnPrimary { background: var(--cta); border-color: var(--cta); color: var(--on-accent); }
+.btnPrimary:hover { background: var(--cta-dark); border-color: var(--cta-dark); }
+.btnLight { background: var(--nav-text); color: var(--text); border-color: var(--nav-text); }
+.btnPrimary:focus-visible, .btnLight:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 3px; }
+
+.free { background: var(--surface); border-top: 1px solid var(--border); }
+.freeGrid { display: grid; gap: 32px; align-items: center; }
+@media (min-width: 860px) { .freeGrid { grid-template-columns: 1fr 1fr; gap: 56px; } }
+.freeCard { border: 2px solid var(--text); background: var(--surface); padding: 22px 20px; }
+.freeHead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
+.freeHead h3 { margin: 0; font-size: var(--step-2); font-weight: 800; }
+.freeHead span { font-size: 2.6rem; font-weight: 800; line-height: 1; }
+.lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.lines li { display: grid; grid-template-columns: 20px 1fr; gap: 8px; font-size: var(--step-0); line-height: 1.5; }
+.yes { color: var(--text); } .yes > span:first-child { color: var(--green); font-weight: 800; }
+.no { color: var(--muted); } .no > span:first-child { font-weight: 800; }
+
+.human { background: var(--nav-bg); color: var(--nav-text); }
+.humanGrid { display: grid; gap: 1px; margin: 8px 0 28px; background: var(--nav-border); border: 1px solid var(--nav-border); }
+@media (min-width: 860px) { .humanGrid { grid-template-columns: repeat(3, 1fr); } }
+.humanItem { padding: 20px 18px; background: var(--nav-bg); display: grid; gap: 8px; align-content: start; }
+.humanItem h3 { margin: 0; font-size: var(--step-1); font-weight: 800; }
+.humanItem p { margin: 0; color: var(--nav-muted); font-size: var(--step--1); line-height: 1.6; }
+
+.faq { background: var(--bg); }
+.faqList { max-width: 760px; margin: 8px auto 20px; border-top: 2px solid var(--text); }
+.faqItem { border-bottom: 1px solid var(--border2); }
+.faqItem summary {
+  cursor: pointer; list-style: none;
+  display: flex; justify-content: space-between; gap: 16px; align-items: center;
+  padding: 18px 2px; min-height: 56px;
+  font-size: var(--step-1); font-weight: 800; color: var(--text);
+}
+.faqItem summary::-webkit-details-marker { display: none; }
+.faqItem summary::after { content: "+"; font-size: 1.5rem; font-weight: 700; color: var(--accent-text); flex-shrink: 0; }
+.faqItem[open] summary::after { content: "−"; }
+.faqItem summary:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }
+.faqItem p { margin: 0 0 18px; color: var(--text2); font-size: var(--step-0); line-height: 1.7; }
+.small { text-align: center; color: var(--muted); font-size: var(--step--1); }
+.small a { color: var(--accent-text); }
