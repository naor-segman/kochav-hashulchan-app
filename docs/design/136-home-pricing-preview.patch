@@ -0,0 +1,111 @@
+/* Square everywhere (owner, 4.10: "הריבועים"). One saturated thing per card —
+   the button — and the highlighted package only gets a heavier ink edge. */
+.wrap { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); }
+
+.picker {
+  justify-self: center;
+  width: min(100%, 480px);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  padding: 24px 20px 18px;
+  display: grid;
+  gap: 16px;
+  justify-items: center;
+  text-align: center;
+}
+.q { margin: 0; font-size: var(--step-2); font-weight: 800; color: var(--text); }
+
+.stepper { display: flex; align-items: center; gap: clamp(8px, 3vw, 18px); }
+.stepBtn {
+  width: 48px; height: 48px; flex-shrink: 0;
+  border: 2px solid var(--text);
+  background: var(--surface);
+  color: var(--text);
+  font-size: 1.6rem; line-height: 1; font-weight: 700;
+  cursor: pointer;
+}
+.stepBtn:hover:not(:disabled) { background: var(--text); color: var(--surface); }
+.stepBtn:disabled { opacity: .3; cursor: default; }
+.stepBtn:focus-visible, .preset:focus-visible, .countInput:focus-visible, .cta:focus-visible {
+  outline: 3px solid var(--focus-ring); outline-offset: 2px;
+}
+
+.count { display: grid; justify-items: center; }
+.countInput {
+  width: 3.6ch;
+  border: 0; border-bottom: 2px solid transparent;
+  background: transparent;
+  font: 800 2.9rem/1 var(--font-family-base);
+  color: var(--text);
+  text-align: center;
+  font-variant-numeric: tabular-nums;
+  -moz-appearance: textfield; appearance: textfield;
+}
+.countInput::-webkit-outer-spin-button, .countInput::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
+.countInput:hover { border-bottom-color: var(--border2); }
+.unit { font-size: var(--step--1); color: var(--muted); font-weight: 600; }
+
+.presets { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
+.preset {
+  min-width: 56px; min-height: 44px;
+  border: 1px solid var(--border2);
+  background: var(--surface);
+  color: var(--text2);
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  cursor: pointer;
+}
+.presetOn { background: var(--cta); border-color: var(--cta); color: var(--on-accent); }
+
+.rules {
+  margin: 4px 0 0; padding-top: 12px; width: 100%;
+  border-top: 1px solid var(--border);
+  font-size: var(--step--1); color: var(--text2); font-weight: 600;
+}
+
+.cards {
+  display: grid;
+  gap: 16px;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
+  max-width: 820px;
+  width: 100%;
+  justify-self: center;
+}
+.card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  padding: 24px 20px;
+  display: grid;
+  align-content: start;
+  gap: 12px;
+}
+.cardHi { border: 2px solid var(--text); }
+.name { margin: 0; font-size: var(--step-3); font-weight: 800; color: var(--text); letter-spacing: -.01em; }
+.lead { margin: 0; color: var(--text2); font-size: var(--step-0); min-height: 2.8em; }
+.price { margin: 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
+.amount { font-size: 2.6rem; font-weight: 800; color: var(--text); line-height: 1; font-variant-numeric: tabular-nums; }
+.per { color: var(--muted); font-size: var(--step--1); font-weight: 600; }
+
+.cta {
+  display: flex; align-items: center; justify-content: center;
