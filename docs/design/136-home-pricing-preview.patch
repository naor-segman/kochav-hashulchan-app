-   AIDA's Interest step. Deliberately the quietest band on the page: it is the
-   reader's own situation being described back to them, and any decoration here
-   would read as a sales device rather than recognition. The turn at the end is
-   the only line that raises its voice. */
-.problem {
-  background: var(--surface);
-  padding: clamp(56px, 9vw, 96px) 0;
-  scroll-margin-top: 84px;
-}
-
-.problemGrid {
-  display: grid;
-  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
-  gap: 1px;
-  background: var(--border);
-  border: 1px solid var(--border);
-  border-radius: var(--radius-lg);
-  overflow: hidden;
-  margin-top: 34px;
-}
-
-.problemItem {
-  background: var(--surface);
-  padding: 20px 22px;
-  display: flex;
-  flex-direction: column;
-  gap: 6px;
-}
-
-.problemWhere {
-  margin: 0;
-  font-size: var(--step-0);
-  font-weight: 800;
-  color: var(--text);
-}
-
-.problemWhat {
-  margin: 0;
-  font-size: var(--step--1);
-  line-height: 1.55;
-  color: var(--muted);
-}
-
-/* The one line that turns the section. Left-bordered rather than centred, so it
-   reads as a consequence of the list above it and not as a pull quote. */
-.problemTurn {
-  margin: 26px 0 0;
-  padding-inline-start: 16px;
-  border-inline-start: 3px solid var(--accent);
-  font-size: var(--step-1);
-  font-weight: 700;
-  line-height: 1.5;
-  color: var(--text);
-  max-width: 40rem;
+  background: var(--blush-soft);
+  border: 1px solid var(--blush);
+  border-top: 4px solid var(--cta);
+  transition: background var(--transition);
+}
+.celebrateCard:hover { background: var(--blush); }
+.celebrateName { font-size: clamp(1.35rem, 4.6vw, 1.9rem); font-weight: 800; color: var(--text); line-height: 1.1; letter-spacing: -.01em; }
+.celebrateText { font-size: var(--step--1); line-height: 1.55; color: var(--text2); }
+.celebrateGo { margin-top: auto; font-weight: 800; font-size: var(--step--1); color: var(--accent-text); }
+
+/* ── 6 · human ────────────────────────────────────────────────────────── */
+.human { position: relative; background: var(--nav-bg); color: var(--nav-text); overflow: hidden; }
+.humanMedia { position: absolute; inset: 0; }
+.humanMedia img { width: 100%; height: 100%; object-fit: cover; opacity: .22; display: block; }
+.humanInner { position: relative; display: grid; justify-items: start; }
+.humanList { display: grid; gap: 1px; width: 100%; margin: 4px 0 28px; background: var(--nav-border); border: 1px solid var(--nav-border); }
+@media (min-width: 860px) { .humanList { grid-template-columns: repeat(3, 1fr); } }
+.humanItem { display: flex; gap: 14px; align-items: flex-start; padding: 18px 16px; background: rgba(var(--text-rgb), .82); }
+.humanItem h3 { margin: 0 0 4px; font-size: var(--step-1); font-weight: 800; }
+.humanItem p { margin: 0; color: var(--nav-muted); font-size: var(--step--1); line-height: 1.55; }
+
+/* ── 7 · price ────────────────────────────────────────────────────────── */
+.price { background: var(--bg); }
+.priceGrid { display: grid; gap: 16px; max-width: 860px; margin-inline: auto; }
+@media (min-width: 760px) { .priceGrid { grid-template-columns: 1fr 1fr; } }
+.freeCard, .paidCard { display: flex; flex-direction: column; padding: 26px 22px; background: var(--surface); border: 1px solid var(--border); }
+.freeCard { border: 2px solid var(--text); }
+.freeAmount { margin: 0 0 6px; font-size: 3.4rem; font-weight: 800; line-height: 1; color: var(--text); }
+.freeLines { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 8px; }
+.freeLines li { display: flex; gap: 10px; font-size: var(--step-0); color: var(--text); }
+.freeLines span { color: var(--green); font-weight: 800; }
+.paidFrom { margin: 0 0 12px; font-size: var(--step-2); font-weight: 800; color: var(--text); }
+.paidFrom span { font-size: 2.4rem; font-variant-numeric: tabular-nums; }
+
+/* ── 9 · close ────────────────────────────────────────────────────────── */
+.close { background: var(--nav-bg); color: var(--nav-text); }
+.closeInner { display: grid; justify-items: center; text-align: center; }
+.closeTitle { margin: 0 0 12px; font-size: clamp(2.6rem, 10vw, 4.6rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; }
+
+@media (prefers-reduced-motion: reduce) {
+  .tile, .tile:hover { transition: none; transform: none; }
 }
