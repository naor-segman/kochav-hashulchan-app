# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite
*.local

# Vite's dependency pre-bundle cache. Normally it lands in node_modules/.vite,
# but a dev server started after that directory is cleared writes it to the repo
# root instead — 5.5MB of build artefact that then shows up as untracked.
.vite/

# QA screenshots — written by qa/shot.mjs and qa/palette.mjs, never committed.
qa/shots/

# Background agents create git worktrees here — a full second copy of the repo,
# inside the repo. Never commit one. Scoped to worktrees/ rather than the whole
# of .claude/ so a real settings file stays trackable.
.claude/worktrees/
